{
  "name": "starscout-extension",
  "description": "GitHub star integrity badge powered by StarScout-derived signals.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "WXT_PUBLIC_STARSCOUT_API_BASE_URL=http://127.0.0.1:8000 wxt",
    "dev:firefox": "WXT_PUBLIC_STARSCOUT_API_BASE_URL=http://127.0.0.1:8000 wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:beta": "WXT_PUBLIC_STARSCOUT_API_BASE_URL=https://starscout-extension-api.arthurnun.es wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "wxt": "^0.20.25"
  }
}
